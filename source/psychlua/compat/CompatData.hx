	/** 掩码中某下标位是否为 1 */
	public static inline function maskHas(mask:String, index:Int):Bool
		return mask != null && index >= 0 && index < mask.length && mask.charAt(index) == "1";

	/** 某函数可用版本的名称列表；未知函数返回空数组 */
	public static function versionsOfFunction(name:String):Array<String>
	{
		var out:Array<String> = [];
		var m:String = FUNC_MASK.get(name);
		if (m == null) return out;
		for (i in 0...VERSIONS.length) if (maskHas(m, i)) out.push(VERSIONS[i]);
		return out;
	}

	/** 某钩子会生效的版本名称列表；未知钩子返回空数组 */
	public static function versionsOfHook(name:String):Array<String>
	{
		var out:Array<String> = [];
		var m:String = HOOK_MASK.get(name);
		if (m == null) return out;
		for (i in 0...VERSIONS.length) if (maskHas(m, i)) out.push(VERSIONS[i]);
		return out;
	}
